-------------------------------------------------------------------------------
-- Top-level items

data Kind = PP | Fun | Dat | Decl

||| One top-level item: a preprocessor line, a function definition, a data
||| definition (`... = ...;`) or a declaration (`...;`). Positions are byte
||| offsets into the input; `start` is the end of the previous item, so the
||| blanks and comments in front of an item belong to it.
record Item where
  constructor MkItem
  kind : Kind
  start : Int
  ||| The first token, or -1 for trailing blanks and comments only.
  tok : Int
  ||| The `=` of the initializer, or -1.
  eqAt : Int
  ||| The first `(` at depth 0 before the initializer, or -1.
  parenAt : Int
  ||| The first `{` at depth 0 before the initializer and the end of its
  ||| block (an anonymous struct type), or -1.
  braceAt : Int
  braceEnd : Int
  end : Int

record Scan where
  constructor MkScan
  depth : Int
  start : Int
  tok : Int
  eqAt : Int
  parenAt : Int
  braceAt : Int
  braceEnd : Int
  ||| The `{` at depth 0 opened a function body.
  body : Bool
  ||| The last byte at depth 0 that was not a blank or a comment.
  prev : Int
  ||| Only blanks since the last newline.
  bol : Bool

fresh : Int -> Scan
fresh i = MkScan 0 i (-1) (-1) (-1) (-1) (-1) False 0 True

byteAt : Buffer -> Int -> IO Int
byteAt b i = cast <$> getBits8 b i

isIdentByte : Int -> Bool
isIdentByte c = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95

isBlank : Int -> Bool
isBlank c = c == 32 || c == 9 || c == 10 || c == 13

scanItems : Buffer -> Int -> IO (Either String (List Item))
scanItems b size = go 0 (fresh 0) [<]
  where
    lineEnd : Int -> IO Int
    lineEnd j = if j >= size then pure size
                else if !(byteAt b j) == 10 then pure j else lineEnd (j + 1)

    blockEnd : Int -> IO Int
    blockEnd j = if j + 1 >= size then pure size
                 else if !(byteAt b j) == 42 && !(byteAt b (j + 1)) == 47 then pure (j + 2)
                 else blockEnd (j + 1)

    quoteEnd : Int -> Int -> IO Int
    quoteEnd q j = if j >= size then pure size
                   else do c <- byteAt b j
                           if c == 92 then quoteEnd q (j + 2)
                             else if c == q then pure (j + 1)
                             else quoteEnd q (j + 1)

    -- A preprocessor line ends at a newline that no backslash continues.
    ppEnd : Int -> IO Int
    ppEnd j = do e <- lineEnd j
                 if e < size && e > 0 && !(byteAt b (e - 1)) == 92 then ppEnd (e + 1)
                   else pure (min size (e + 1))

    emit : Kind -> Int -> Scan -> SnocList Item -> (Scan, SnocList Item)
    emit k e s acc = (fresh e, acc :< MkItem k s.start s.tok s.eqAt s.parenAt s.braceAt s.braceEnd e)

    seen : Int -> Scan -> Scan
    seen i s = { tok := if s.tok < 0 then i else s.tok, bol := False } s

    step : Int -> Int -> Int -> Scan -> SnocList Item -> IO (Either String (List Item))

    go : Int -> Scan -> SnocList Item -> IO (Either String (List Item))
    go i s acc =
      if i >= size
        then if s.tok >= 0 then pure (Left "the input ends inside an item")
             else pure (Right (acc <>> if s.start < size then [MkItem Decl s.start (-1) (-1) (-1) (-1) (-1) size] else []))
        else do
          c <- byteAt b i
          n <- if i + 1 < size then byteAt b (i + 1) else pure 0
          step i c n s acc

    step i c n s acc =
      if c == 10 then go (i + 1) ({ bol := True } s) acc
      else if isBlank c then go (i + 1) s acc
      else if c == 47 && n == 47 then go !(lineEnd (i + 2)) s acc
      else if c == 47 && n == 42 then go !(blockEnd (i + 2)) ({ bol := False } s) acc
      else if c == 35 && s.bol
        then do e <- ppEnd i
                -- Inside a function body the line stays where it is; it is
                -- not C, so its quotes are not scanned as literals.
                if s.depth > 0 then go e s acc
                  else if s.tok >= 0 then pure (Left "a preprocessor line inside an item at byte \{show i}")
                  else let (s', acc') = emit PP e (seen i s) acc in go e s' acc'
      else if c == 34 || c == 39
        then do e <- quoteEnd c (i + 1)
                go e ({ prev := if s.depth == 0 then c else s.prev } (seen i s)) acc
      else let s = seen i s in
        if c == 123 || c == 40 || c == 91 then go (i + 1) (opening c s) acc
        else if c == 125 || c == 41 || c == 93 then closing c s
        else if s.depth == 0 && c == 59
          then let (s', acc') = emit (if s.eqAt >= 0 then Dat else Decl) (i + 1) s acc in go (i + 1) s' acc'
        else if s.depth == 0
          then go (i + 1) ({ prev := c, eqAt := if c == 61 && s.eqAt < 0 then i else s.eqAt } s) acc
        else go (i + 1) s acc
      where
        opening : Int -> Scan -> Scan
        opening c s =
          let top = s.depth == 0
              s = { depth $= (+ 1) } s
          in if not top then s
             else if c == 123 && s.prev == 41 && s.eqAt < 0 then { body := True } s
             else if c == 123 && s.eqAt < 0 && s.braceAt < 0 then { braceAt := i } s
             else if c == 40 && s.eqAt < 0 && s.parenAt < 0 then { parenAt := i } s
             else s

        closing : Int -> Scan -> IO (Either String (List Item))
        closing c s =
          let s = { depth $= (\d => d - 1) } s in
          if s.depth < 0 then pure (Left "unbalanced brackets at byte \{show i}")
          else if s.depth == 0 && c == 125 && s.body
            then let (s', acc') = emit Fun (i + 1) s acc in go (i + 1) s' acc'
          else if s.depth == 0
            then go (i + 1) ({ prev := c, braceEnd := if c == 125 && s.braceAt >= 0 && s.braceEnd < 0 && s.eqAt < 0 then i + 1 else s.braceEnd } s) acc
          else go (i + 1) s acc

-------------------------------------------------------------------------------
-- Words and names

||| The identifiers at the front of an item, up to the first other token
||| (`static inline IDRIS2RC2_Value *f(...)` gives the first three).
leadingWords : Buffer -> Int -> Int -> IO (List String)
leadingWords b i end = go i [<]
  where
    identEnd : Int -> IO Int
    identEnd j = if j < end && isIdentByte !(byteAt b j) then identEnd (j + 1) else pure j

    go : Int -> SnocList String -> IO (List String)
    go j acc =
      if j >= end then pure (acc <>> [])
      else do
        c <- byteAt b j
        if isBlank c then go (j + 1) acc
          else if isIdentByte c
            then do e <- identEnd j
                    w <- getString b j (e - j)
                    go e (acc :< w)
            else pure (acc <>> [])

||| The identifier that ends right before `p`, past blanks and `[...]`
||| suffixes (`char const name[] = ...`).
nameBefore : Buffer -> Int -> IO String
nameBefore b p = back (p - 1) (the Int 0)
  where
    identStart : Int -> IO Int
    identStart j = if j >= 0 && isIdentByte !(byteAt b j) then identStart (j - 1) else pure (j + 1)

    back : Int -> Int -> IO String
    back j nest =
      if j < 0 then pure ""
      else do
        c <- byteAt b j
        if c == 93 then back (j - 1) (nest + 1)
          else if c == 91 then back (j - 1) (nest - 1)
          else if nest > 0 || isBlank c then back (j - 1) nest
          else if isIdentByte c
            then do s <- identStart j
                    getString b s (j + 1 - s)
            else pure ""

-------------------------------------------------------------------------------
-- Output

data Piece = Lit String | Slice Int Int

||| Where an item's text goes: the shared header, the current part, the
||| first part, and declarations appended to the header.
record Placed where
  constructor MkPlaced
  header : List Piece
  part : List Piece
  firstPart : List Piece
  externs : List Piece

local : String
local = "RC2SPLIT_LOCAL"

||| The item with its leading `static` (6 bytes at `tok`) replaced by the
||| hidden visibility macro.
unstatic : Item -> List Piece
unstatic it = [Slice it.start it.tok, Lit local, Slice (it.tok + 6) it.end]

place : Buffer -> SortedSet String -> (inParts : Bool) -> Item -> IO (Either String Placed)
place b dataNames inParts it = case it.kind of
    PP => if inParts then failAt "a preprocessor line after the first definition"
          else ok (header [whole])
    Fun => do
      ws <- words
      let isStatic = staticFirst ws
      if elem "inline" ws
        then if isStatic then ok (header [whole]) else failAt "an inline function that is not static"
        else ok (part (if isStatic then unstatic it else [whole]))
    Dat => do
      ws <- words
      let isStatic = staticFirst ws
      name <- nameBefore b it.eqAt
      if name == "" then failAt "a data definition whose name was not found"
        else if it.braceAt < 0
          then ok (MkPlaced [] (if isStatic then unstatic it else [whole]) []
                    [Lit (if isStatic then "extern " ++ local else "extern "),
                     Slice (if isStatic then it.tok + 6 else it.tok) it.eqAt, Lit ";\n"])
          else anonymous isStatic ws name
    Decl =>
      if it.tok < 0 then ok (if inParts then part [whole] else header [whole])
      else do
        ws <- words
        case ws of
          (w :: _) =>
            if isPrefixOf "__" w then failAt "an item that starts with a compiler extension"
            else if elem w ["extern", "typedef"] then ok (header [whole])
            else if elem w ["struct", "union", "enum"] then typeBlock
            else if it.parenAt >= 0 then prototype w
            else if w == "static" then failAt "a static variable without an initializer"
            else tentative
          [] => if it.end - it.tok == 1 then ok (if inParts then part [whole] else header [whole])
                else failAt "an item that does not start with an identifier"
  where
    whole : Piece
    whole = Slice it.start it.end

    ok : Placed -> IO (Either String Placed)
    ok = pure . Right

    header : List Piece -> Placed
    header ps = MkPlaced ps [] [] []

    part : List Piece -> Placed
    part ps = MkPlaced [] ps [] []

    failAt : String -> IO (Either String Placed)
    failAt why = pure (Left "\{why} at byte \{show it.tok}")

    words : IO (List String)
    words = leadingWords b it.tok it.end

    staticFirst : List String -> Bool
    staticFirst ws = take 1 ws == ["static"]

    blanksUpTo : Int -> Int -> IO Bool
    blanksUpTo j e = if j >= e then pure True
                     else if isBlank !(byteAt b j) then blanksUpTo (j + 1) e else pure False

    nextByte : Int -> IO Int
    nextByte j = if j >= it.end then pure 0
                 else do c <- byteAt b j
                         if isBlank c then nextByte (j + 1) else pure c

    -- A type definition goes to every part; a variable declared with it
    -- (`struct S { ... } v;`) would be defined in every part.
    typeBlock : IO (Either String Placed)
    typeBlock =
      if it.braceAt < 0 then failAt "a variable of a struct, union or enum type without an initializer"
      else do bare <- blanksUpTo it.braceEnd (it.end - 1)
              if bare then ok (header [whole])
                else failAt "a variable declared with a struct, union or enum definition"

    -- `T (*fp)(int);` is a variable, not a prototype.
    prototype : String -> IO (Either String Placed)
    prototype w = do
      c <- nextByte (it.parenAt + 1)
      if c == 42 then failAt "a variable of a function pointer type"
        else ok (header (if w == "static" then unstatic it else [whole]))

    -- A tentative definition (`char const name[];`): a definition in every
    -- part that sees it, so the header only declares it.
    tentative : IO (Either String Placed)
    tentative = do
      name <- nameBefore b (it.end - 1)
      ok (MkPlaced [] [] (if contains name dataNames then [] else [whole])
                   [Lit "extern ", Slice it.tok it.end, Lit "\n"])

    -- `[static] struct { ... } const name = ...;`: the two translation units
    -- that declare and define it must see the same type, and two anonymous
    -- structs are two types, so the struct gets a name in the header.
    anonymous : Bool -> List String -> String -> IO (Either String Placed)
    anonymous isStatic ws name =
      if drop (if isStatic then 1 else 0) (take (if isStatic then 2 else 1) ws) /= ["struct"]
        then failAt "a data definition with a type block that is not an anonymous struct"
        else do
          let ty = "rc2split_t_" ++ name
          let structAt = if isStatic then it.tok + 6 else it.tok
          let vis = if isStatic then local ++ " " else ""
          ok (MkPlaced [] [Slice it.start it.tok, Lit (vis ++ ty), Slice it.braceEnd it.end] []
                [Lit "typedef ", Slice structAt it.braceEnd, Lit (" " ++ ty ++ ";\n"),
                 Lit ("extern " ++ vis ++ ty), Slice it.braceEnd it.eqAt, Lit ";\n"])

-------------------------------------------------------------------------------
-- Partitioning and writing

||| The parts, each a list of pieces, cut before a data or function item once
||| a part has `target` bytes and ends with a function: the constants rc2
||| stages for a function come right before it, so they stay together.
record Layout where
  constructor MkLayout
  header : SnocList Piece
  externs : SnocList Piece
  firstPart : SnocList Piece
  parts : SnocList (SnocList Piece)
  current : SnocList Piece
  size : Int
  lastFun : Bool
  inParts : Bool

layout : Buffer -> Int -> List Item -> IO (Either String Layout)
layout b target items = do
    names <- dataNames
    go names items (MkLayout [<] [<] [<] [<] [<] 0 False False)
  where
    isDat : Item -> Bool
    isDat it = case it.kind of { Dat => True; _ => False }

    dataNames : IO (SortedSet String)
    dataNames = fromList <$> traverse (\it => nameBefore b it.eqAt) (filter isDat items)

    startsPart : Kind -> Bool
    startsPart Fun = True
    startsPart Dat = True
    startsPart _ = False

    go : SortedSet String -> List Item -> Layout -> IO (Either String Layout)
    go _ [] l = pure (Right l)
    go names (it :: rest) l = do
      Right p <- place b names l.inParts it
        | Left err => pure (Left err)
      let l = if startsPart it.kind && l.lastFun && l.size >= target
                then { parts $= (:< l.current), current := [<], size := 0 } l
                else l
      let l = { header $= (<>< p.header), externs $= (<>< p.externs),
                firstPart $= (<>< p.firstPart), current $= (<>< p.part),
                size $= (+ (if startsPart it.kind then it.end - it.start else 0)),
                lastFun := case it.kind of { Fun => True; Decl => l.lastFun; _ => False },
                inParts := l.inParts || startsPart it.kind } l
      go names rest l

writePieces : File -> Buffer -> List Piece -> IO (Either String ())
writePieces h b [] = pure (Right ())
writePieces h b (Lit s :: ps) = do
  Right () <- fPutStr h s
    | Left err => pure (Left (show err))
  writePieces h b ps
writePieces h b (Slice s e :: ps) =
  if e <= s then writePieces h b ps
  else do
    Right () <- writeBufferData h b s (e - s)
      | Left (err, _) => pure (Left (show err))
    writePieces h b ps

writeFileOf : String -> Buffer -> List Piece -> IO (Either String ())
writeFileOf path b ps = do
  Right h <- openFile path WriteTruncate
    | Left err => pure (Left "\{path}: \{show err}")
  r <- writePieces h b ps
  fflush h
  failed <- fileError h
  closeFile h
  let r = if failed && isRight r then Left "a write failed" else r
  pure (mapFst (\e => "\{path}: \{e}") r)

-------------------------------------------------------------------------------
-- Makefile

||| rc2's command lines (`--directive writecc`): where they ran, the object
||| file of the whole program, its compile command and the command that
||| links (or archives) the object.
record Commands where
  constructor MkCommands
  cwd : String
  object : String
  compile : String
  final : String

readCommands : String -> IO (Either String Commands)
readCommands path = do
    Right text <- readFile path
      | Left err => pure (Left "\{path}: \{show err}")
    let fields = map (break (== ' ')) (lines text)
    pure $ do
      cwd <- field fields "cwd"
      object <- field fields "object"
      compile <- field fields "compile"
      final <- field fields "final"
      Right (MkCommands cwd object compile final)
  where
    field : List (String, String) -> String -> Either String String
    field fs key = case lookup key fs of
                     Just v => Right (ltrim v)
                     Nothing => Left "\{path}: no `\{key}` line"

||| An argument as rc2's command lines quote it (`escapeCmd`).
quoteArg : String -> String
quoteArg = escapeArg

||| `s` with every `old` replaced by `new`, or Nothing when `old` is not in it.
replaceAll : (old : String) -> (new : String) -> String -> Maybe String
replaceAll old new s = let (n, out) = go 0 [<] (unpack s) in
                       if n == 0 then Nothing else Just (pack (out <>> []))
  where
    o : List Char
    o = unpack old

    go : Nat -> SnocList Char -> List Char -> (Nat, SnocList Char)
    go n acc [] = (n, acc)
    go n acc cs@(c :: rest) =
      if isPrefixOf o cs then go (S n) (acc <>< unpack new) (drop (length o) cs)
      else go n (acc :< c) rest

||| The quoted argument after the quoted `flag` in a command line
||| (`"-c" "main.c"` gives `"main.c"`).
argAfter : (flag : String) -> String -> Maybe String
argAfter flag cmd = case findSub (unpack (quoteArg flag ++ " \"")) (unpack cmd) of
    Just rest => map (\body => "\"" ++ pack body ++ "\"") (quoted rest)
    Nothing => Nothing
  where
    findSub : List Char -> List Char -> Maybe (List Char)
    findSub pat [] = Nothing
    findSub pat cs@(_ :: rest) = if isPrefixOf pat cs then Just (drop (length pat) cs) else findSub pat rest

    quoted : List Char -> Maybe (List Char)
    quoted ('\\' :: c :: rest) = map (\b => '\\' :: c :: b) (quoted rest)
    quoted ('"' :: _) = Just []
    quoted (c :: rest) = map (c ::) (quoted rest)
    quoted [] = Nothing

||| The Makefile that builds the parts with rc2's own commands: each part's
||| `.o` from the compile command, the whole program's object from the parts'
||| (`ld -r`; `objcopy --localize-hidden`, so that what was `static` is local
||| again, also in a static library; `ld -r --gc-sections` from the global
||| symbols, so that what was `static` and unused goes, as the C compiler
||| leaves it out of one translation unit), and `all` from the final command
||| as rc2 wrote it. `clean` removes all of these and what the final command
||| makes (its `-o`, or the archive of `ar rcs`). Paths are absolute.
makefile : String -> Commands -> (header : String) -> (parts : List String) -> Either String String
makefile input cmds header parts = do
    when (any unsafeForMake (header :: parts)) $
      Left "a path with a blank or one of `:#$%*?[\\` cannot be a make target"
    src <- maybe (Left "the compile command has no `-c` argument") Right (argAfter "-c" cmds.compile)
    let cwd = forMake (quoteArg cmds.cwd)
    let obj = quoteArg cmds.object
    let merged' = quoteArg (cmds.object ++ ".parts.o")
    let syms' = quoteArg (cmds.object ++ ".syms")
    let roots' = quoteArg (cmds.object ++ ".roots")
    let merged = forMake merged'
    let syms = forMake syms'
    let roots = forMake roots'
    let objs = map objOf parts
    rules <- traverse (rule src obj) (zip parts objs)
    let product = maybe [] pure (argAfter "-o" cmds.final <|> argAfter "rcs" cmds.final)
    Right $ unlines $
      [ "# Written by c-split from \{input}: each part is compiled with rc2's compile"
      , "# command, the parts make the one object rc2's final command takes, and `all`"
      , "# runs that command. `make -j N` runs N compilers at once (each part takes a"
      , "# few hundred MB with clang -O2)."
      , ".PHONY: all"
      , "all: " ++ unwords objs
      , "\tcd " ++ cwd ++ " && ld -r -o " ++ merged ++ " " ++ unwords (map quoteArg objs)
          ++ " && objcopy --localize-hidden " ++ merged
      , "\tcd " ++ cwd ++ " && nm -g --defined-only " ++ merged ++ " > " ++ syms
          ++ " && awk '{ print \"-u\", $$3 }' " ++ syms ++ " > " ++ roots
          ++ " && ld -r --gc-sections @" ++ roots ++ " -o " ++ forMake obj ++ " " ++ merged
      , "\tcd " ++ cwd ++ " && " ++ forMake cmds.final
      , ""
      , ".PHONY: clean"
      , "clean:"
      , "\tcd " ++ cwd ++ " && rm -f " ++ unwords (map forMake ([obj, merged', syms', roots'] ++ product) ++ map quoteArg objs)
      , "" ] ++ rules
  where
    unsafeForMake : String -> Bool
    unsafeForMake p = any (\c => elem c [' ', '\t', ':', '#', '$', '%', '*', '?', '[', '\\']) (unpack p)

    objOf : String -> String
    objOf p = substr 0 (length p `minus` 2) p ++ ".o"

    forMake : String -> String
    forMake = concatMap (\c => if c == '$' then "$$" else singleton c) . unpack

    rule : String -> String -> (String, String) -> Either String String
    rule src obj (p, o) = do
      c1 <- maybe (Left "the compile command does not name the source file") Right
              (replaceAll src (quoteArg p) cmds.compile)
      c2 <- maybe (Left "the compile command does not name the object file") Right
              (replaceAll obj (quoteArg o) c1)
      Right "\{o}: \{p} \{header}\n\tcd \{forMake (quoteArg cmds.cwd)} && \{forMake c2}\n"

-------------------------------------------------------------------------------
-- Command line

||| Exit code 1: the input is outside what this tool splits; the caller
||| compiles it whole instead.
refuse : String -> IO a
refuse msg = do
  ignore (fPutStrLn stderr ("c-split: " ++ msg))
  exitWith (ExitFailure 1)

||| Exit code 2: a usage or file error.
die : String -> IO a
die msg = do
  ignore (fPutStrLn stderr ("c-split: " ++ msg))
  exitWith (ExitFailure 2)

record Options where
  constructor MkOptions
  partBytes : Int
  commands : Maybe String
  positional : List String

parseOptions : Options -> List String -> Maybe Options
parseOptions o ("--part-bytes" :: n :: rest) = parsePositive {a = Int} n >>= \t => parseOptions ({ partBytes := t } o) rest
parseOptions o ("--commands" :: f :: rest) = parseOptions ({ commands := Just f } o) rest
parseOptions o (a :: rest) = if isPrefixOf "--" a then Nothing else parseOptions ({ positional $= (++ [a]) } o) rest
parseOptions o [] = Just o

main : IO ()
main = do
  args <- drop 1 <$> getArgs
  Just (MkOptions target cmdFile [input, outDir]) <- pure (parseOptions (MkOptions 4000000 Nothing []) args)
    | _ => die usage
  cmds <- the (IO (Maybe Commands)) $ case cmdFile of
            Nothing => pure Nothing
            Just f => do Right c <- readCommands f
                           | Left err => die err
                         pure (Just c)
  Right b <- createBufferFromFile input
    | Left err => die "\{input}: \{show err}"
  size <- rawSize b
  Right items <- scanItems b size
    | Left err => refuse "cannot split \{input}: \{err}"
  Right l <- layout b target items
    | Left err => refuse "cannot split \{input}: \{err}"
  ignore (createDir outDir)
  Just here <- currentDir
    | Nothing => die "cannot read the current directory"
  let absOut = if isPrefixOf "/" outDir then outDir else here ++ "/" ++ outDir
  let stem = stemOf input
  let parts = (l.parts :< l.current) <>> []
  let header = outDir ++ "/" ++ stem ++ ".h"
  let names = map (\k => stem ++ "-" ++ show k ++ ".c") [0 .. length parts `minus` 1]
  mk <- the (IO (Maybe String)) $ case cmds of
          Nothing => pure Nothing
          Just c => case makefile input c (absOut ++ "/" ++ stem ++ ".h") (map (\n => absOut ++ "/" ++ n) names) of
                      Right text => pure (Just text)
                      Left err => refuse "cannot write a Makefile for \{input}: \{err}"
  Right () <- writeFileOf header b
                (Lit "#define \{local} __attribute__((visibility(\"hidden\")))\n"
                  :: (l.header <>> []) ++ Lit "\n" :: (l.externs <>> []))
    | Left err => die err
  for_ (zip3 [the Nat 0 .. length parts] names parts) $ \(k, name, ps) => do
    let extra = if k == 0 then l.firstPart <>> [] else []
    let path = outDir ++ "/" ++ name
    Right () <- writeFileOf path b (Lit "#include \"\{stem}.h\"\n" :: extra ++ (ps <>> []))
      | Left err => die err
    putStrLn path
  whenJust mk $ \text => do
    Right () <- writeFile (outDir ++ "/Makefile") text
      | Left err => die "\{outDir}/Makefile: \{show err}"
    pure ()
  where
    usage : String
    usage = "usage: c-split [--part-bytes N] [--commands FILE.cmd] INPUT.c OUTDIR"

    stemOf : String -> String
    stemOf path =
      let base = last (split (== '/') path) in
      if isSuffixOf ".c" base then substr 0 (length base `minus` 2) base else base
